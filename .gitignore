# =========================================
# Machine Learning Temporary Files
# =========================================

# Ignore other pickle/joblib files by default
*.pkl
*.joblib

# BUT KEEP THE ACTUAL DEPLOYMENT MODEL
!trained_models/
!trained_models/category_model.pkl

# =========================================
# Training Temporary Files
# =========================================

# Ignore generated temporary training outputs
training/__pycache__/

